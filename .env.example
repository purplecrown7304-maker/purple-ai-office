# Public browser configuration; also used by the cookie-based server Auth client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# One-time server-side setup. Existing, confirmed Supabase Auth user only.
CEO_EMAIL=
# Server only. Supabase direct connection or transaction pooler. Must support
# SET LOCAL ROLE service_role. Keep TLS enabled for remote databases.
DATABASE_URL=
# Exact application origin used for write-request CSRF checks (no trailing path).
APP_ORIGIN=http://localhost:3000
